{
  "name": "dsh-restart-button",
  "version": "0.2.0",
  "description": "Self-contained power control for DSH: sidebar power button with an upward 重启/关机 menu plus a Windows-shutdown-style overlay. Own restart & shutdown engine (no dependency on other plugins), MIT licensed.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "tsdown -c tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keyiadiannao/dsh-restart-button.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "restart",
    "shutdown",
    "power",
    "client-plugin",
    "dsh-plugin"
  ],
  "bugs": {
    "url": "https://github.com/keyiadiannao/dsh-restart-button/issues"
  },
  "homepage": "https://github.com/keyiadiannao/dsh-restart-button#readme"
}
